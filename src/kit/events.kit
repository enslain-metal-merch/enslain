<!-- $title = Events - Enslain Metal Merch -->
<!-- $eventsAriaCurrent = aria-current="page"-->
<!-- @include "partials/_header.kit" -->
<main class="main">
  <div class="clip-path-layer">
    <section class="section">
      <div class="wrapper">
        <div class="grid--two-col">
          <div class="text-container">
            <h1>Upcoming Gigs, Tours, and Events</h1>
            <p>If you go to metal gigs in Finland, you’ve probably seen our merch banner. We are everywhere, all the time, and we love it! Here’s what we have coming up, and you can also browse our abundant (dare I say prolific!) list of <a href="./past-events/">past events</a>.</p>
          </div>
          <figure class="img-container">
            <img src="/assets/img/content/turku--resized.jpg" alt="">
          </figure>
        </div>
      </div>
    </section>
  </div>
  <div class="clip-path-layer">
    <section class="section">
      <div class="wrapper--narrow">
        <ul class="event-list">
          <li class="event">
            <span class="event__detail event__detail--large event__detail--accent">Event Name</span>
            <span class="event__detail event__detail--medium">Secondary info (featured artists, album releases, etc...)</span>
            <span class="event__detail event__detail--small">December 13, 2023 - A Cat Café, Nowheremäki</span>
            <hr>
          </li>
          <li class="event">
            <span class="event__detail event__detail--large event__detail--accent">Battle Beast</span>
            <span class="event__detail event__detail--medium">Featuring Agalloch, Mare Cognitum, Finnr's Cane</span>
            <span class="event__detail event__detail--small">December 15, 2023 - Ikaalinen spa, Ikaalinen</span>
            <hr>
          </li>
          <li class="event">
            <span class="event__detail event__detail--large event__detail--accent">Battle Beast</span>
            <span class="event__detail event__detail--small">December 16, 2023 - Aulanko, Hämeenlinna</span>
            <hr>
          </li>
        </ul>
      </div>
    </section>
  </div>
</main>
<!-- @include "partials/_footer.kit" -->
