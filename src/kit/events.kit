<!-- $title = Events - Enslain Metal Merch -->
<!-- $eventsAriaCurrent = aria-current="page"-->
<!-- @include "partials/_header.kit" -->
<main class="main">
  <div class="clip-path-layer">
    <section class="section topflow">
      <div class="wrapper">
        <div class="grid">
          <div class="text-container">
            <h1>Upcoming gigs, tours, and events</h1>
            <p>If you go to metal gigs in Finland, you’ve probably seen our merch banner. We are everywhere, all the time, and we love it! Here’s what we have coming up, and you can also browse our abundant (dare I say prolific!) list of <a href="./past-events/">past events</a>.</p>
          </div>
          <div class="img-container img-container--framed">
            <img src="/assets/img/content/turku--resized.jpg" alt="">
          </div>
        </div>
      </div>
    </section>
  </div>
  <div class="clip-path-layer">
    <section class="section">
      <div class="wrapper--narrow">
        <ul class="event-list">
          <li class="event">
            <span class="event__detail event-name event-name--large">Event Name</span>
            <span class="event__detail event__detail--medium">December 13, 2023 - A Cat Café, Nowheremäki</span>
            <span class="event__detail event__detail--small">Secondary info (featured artists, album releases, etc...)</span>
            <hr>
          </li>
        </ul>
      </div>
    </section>
  </div>
</main>
<!-- @include "partials/_footer.kit" -->
