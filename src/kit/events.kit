              <span class="event__detail event__detail--small">December 15, 2023 - Ikaalinen spa, Ikaalinen</span>
              <hr>
            </li>
            <li class="event">
              <span class="event__detail event__detail--large"><a href="">Battle Beast</a></span>
              <span class="event__detail event__detail--small">December 16, 2023 - Aulanko, Hämeenlinna</span>
              <hr>
            </li>
            <li class="event">
              <span class="event__detail event__detail--large">Suffocation, Be'lakor, Torture Killer</span>
              <span class="event__detail event__detail--small">October 10th - Lutakko, Jyväskylä</span>
              <hr>
            </li>
            <li class="event">
              <span class="event__detail event__detail--large">Suffocation, Be'lakor, Torture Killer</span>
              <span class="event__detail event__detail--small">October 10th - Lutakko, Jyväskylä</span>
              <hr>
            </li>
            <li class="event">
              <span class="event__detail event__detail--large"><a href="">Suffocation, Be'lakor, Torture Killer</a></span>
              <span class="event__detail event__detail--small">October 10th - Lutakko, Jyväskylä</span>
              <hr>
            </li>
            <li class="event">
              <span class="event__detail event__detail--large">Suffocation, Be'lakor, Torture Killer</span>
              <span class="event__detail event__detail--small">October 10th - Lutakko, Jyväskylä</span>
              <hr>
            </li>
            <li class="event">
              <span class="event__detail event__detail--large"><a href="">Suffocation, Be'lakor, Torture Killer</a></span>
              <span class="event__detail event__detail--small">October 10th - Lutakko, Jyväskylä</span>
              <hr>
