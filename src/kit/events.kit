<!-- $title = Events - Enslain Metal Merch -->
<!-- $metaDescription = Find upcoming Enslain Metal Merch gigs, festivals and tours — and explore our complete searchable concert history. -->
<!-- $eventsAriaCurrent = aria-current="page"-->
<!-- $og-img = /assets/img/theme/og/events.jpg -->
<!-- @include "partials/_header.kit" -->
<main class="main events-v2" id="events-top">
<div class="clip-path-layer events-v2__top-layer">
  <section class="section">
    <div class="wrapper events-v2__hero">
      <p class="events-v2__eyebrow">Enslain Metal Merch / Gig history</p>
      <h1>Gigs, tours &amp; events</h1>
      <p>If you go to metal gigs in Finland, you've probably seen our merch banner. We are everywhere, all the time, and we can't get enough of it! Here's what we have coming up, plus an abundant (dare I say prolific!) history of where we've been.</p>
    </div>
  </section>
</div>
<div class="clip-path-layer events-v2__content-layer"><div class="wrapper events-v2__inner">
<div class="events-v2__controls" role="search" aria-label="Filter events">
  <div class="events-v2__filter-grid">
    <label class="events-v2__filter events-v2__filter--search"><span>Search</span><input type="search" id="events-search" placeholder="Bands, event, venue, city..." autocomplete="off"></label>
    <label class="events-v2__filter"><span>Timing</span><select id="events-timing"><option value="all">All events</option><option value="upcoming">Upcoming</option><option value="past">Past</option></select></label>
    <label class="events-v2__filter"><span>Band</span><input id="events-band" list="events-band-options" type="search" placeholder="All bands" autocomplete="off"></label>
    <label class="events-v2__filter"><span>Country</span><select id="events-country"><option value="">All countries</option><option value="austria">Austria</option><option value="belgium">Belgium</option><option value="bulgaria">Bulgaria</option><option value="canada">Canada</option><option value="croatia">Croatia</option><option value="czechia">Czechia</option><option value="denmark">Denmark</option><option value="estonia">Estonia</option><option value="finland">Finland</option><option value="france">France</option><option value="germany">Germany</option><option value="greece">Greece</option><option value="hungary">Hungary</option><option value="ireland">Ireland</option><option value="italy">Italy</option><option value="latvia">Latvia</option><option value="lithuania">Lithuania</option><option value="netherlands">Netherlands</option><option value="north macedonia">North Macedonia</option><option value="poland">Poland</option><option value="portugal">Portugal</option><option value="romania">Romania</option><option value="serbia">Serbia</option><option value="slovakia">Slovakia</option><option value="slovenia">Slovenia</option><option value="spain">Spain</option><option value="sweden">Sweden</option><option value="switzerland">Switzerland</option><option value="united kingdom">United Kingdom</option><option value="usa">USA</option></select></label>
  </div>
