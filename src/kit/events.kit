<!-- $title = Events - Enslain Metal Merch -->
<!-- $metaDescription = Check out Enslain's upcoming tours and events! Come say hi and pick up some band merch! Don't forget to bookmark this page if you want to keep up to date with Finnish metal gigs and festivals! -->
<!-- $eventsAriaCurrent = aria-current="page"-->
<!-- $og-img = /assets/img/theme/og/events.jpg -->
<!-- @include "partials/_header.kit" -->
<main class="main">

  <div class="clip-path-layer">
    <section class="section topflow">
      <div class="wrapper">
        <div class="grid">
          <div class="text-container">
            <h1>Upcoming gigs, tours, and events</h1>
            <p>If you go to metal gigs in Finland, you’ve probably seen our merch banner. We are everywhere, all the time, and we love it! Here’s what we have coming up, and you can also browse our abundant (dare I say prolific!) list of <a href="./past-events/">past events</a>.</p>
            <p>Don’t forget to bookmark this page if you want to keep up to date with Finnish metal gigs and festivals!</p>
          </div>
          <div class="img-container img-container--framed">
            <img src="/assets/img/content/event-imgs/turku-battle-beast.jpg" alt="Large display of Battle Beast merchandise consisting of t-shirts and hoodies hanging on a wall, as well as vinyls, fabric shopping bags and beanines on a tablet. Enslain's company banner is hanging off the side of the table.">
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="clip-path-layer long-list">
    <section class="section">
      <div class="wrapper--narrow">
        <!-- @include "./partials/events/_2026-upcoming.kit" -->
      </div>
    </section>
  </div>

  <div class="clip-path-layer long-list">
    <section class="section">
      <div class="wrapper--narrow">
         <div class="tour">
          <!-- @include "./partials/events/_2026-tour-pat-metheny.kit" -->
         </div>
      </div>
    </section>
  </div>

  <div class="clip-path-layer long-list">
    <section class="section">
      <div class="wrapper--narrow">
         <div class="tour">
          <!-- @include "./partials/events/_2026-kk-autumn-tour.kit" -->
         </div>
      </div>
    </section>
  </div>

</main>
