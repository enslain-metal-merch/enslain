<!-- $title = Enslain Metal Merch-->
<!-- $metaDescription = Enslain Metal Merch is an independent, music-centric Finnish company with over twenty years of experience selling merchandise at events: primarily, but not exclusively, metal gigs. -->
<!-- $og-img = /assets/img/theme/og/index.jpg -->
<!-- $homeAriaCurrent = aria-current="page" -->
<!-- @include "partials/_header.kit" -->
<main class="main">
  <div class="clip-path-layer">
    <section class="section topflow">
      <div class="wrapper">
        <div class="grid">
          <div class="text-container">
            <h1>Enslain<br> Metal Merch</h1>
            <p>Enslain Metal Merch is an independent, music-centric Finnish company with over twenty years of experience selling merchandise at events: primarily, but not exclusively, metal gigs. </p>
            <p>Our crew consists of friendly and ambitious merch sellers located in numerous major cities throughout Finland, and we also run the merch booths at some of the country’s premiere metal festivals and do tours internationally.</p>
          </div>
          <div class="img-container img-container--framed"><img src="assets/img/content/enslain-index--resized.jpg" alt=""></div>  
        </div>
      </div>
    </section>
  </div>
  <div class="clip-path-layer">
    <section class="section">
      <div class="wrapper">
        <h2>Let’s sell some merch!</h2>
        <p>Interested in hiring us, or working with us?</p>
        <ul class="card-group grid--flexible">
          <li class="card card--service">
            <div class="card__img-container">
              <img src="assets/img/content/kalmah-lutakko-table--resized.jpg"  loading="lazy" alt="">
            </div>
            <div class="card__text-container">
              <h3>For Bands</h3>
              <p>Looking for local sellers for your gigs, or someone to join your crew on tour? That’s what we do!</p>
              <p><a class="button" href="/services/index.html#services-for-bands">Read more</a></p>
            </div>
          </li>
          <li class="card card--service">
            <div class="card__img-container">
              <img src="assets/img/content/metal-capital--resized.jpg"  loading="lazy" alt="">
            </div>
            <div class="card__text-container">
              <h3>For Promoters</h3>
              <p>Need an experienced and affordable crew to manage your event’s merchandise sales? We love festivals!</p>
              <p><a class="button" href="/services/index.html#services-for-promotors">Read more</a></p>
            </div>
          </li>
          <li class="card card--service">
            <div class="card__img-container">
              <img src="assets/img/content/steelfest-2023--resized-2.jpg"  loading="lazy" alt="">
            </div>
            <div class="card__text-container">
              <h3>For Volunteers</h3>
              <p>Have you always wanted to be part of a crew dedicated to music, or do you love the idea of working at events?</p>
              <p><a class="button" href="/volunteers/index.html">Join us!</a></p>
            </div>
          </li>
        </ul>
      </div>
    </section>
  </div>
  <div class="clip-path-layer">
    <section class="section">
      <div class="wrapper">
        <h2>What we’re up to right now</h2>
        <div class="grid--two-col">
          <div class="column subsection">
            <ul class="event-list">
              <li class="event">
                <span class="event__detail event-name event-name--large">Rites of North</span>
                <span class="event__detail event__detail--medium">January 26 - 27, 2024 – Kantakrouvi & Hevimesta, Oulu</span>
                <span class="event__detail event__detail--small">Featuring Beherit and Dødheimsgard + many more</span>
                <hr>
              </li>
              <li class="event">
                <span class="event__detail event-name event-name--large">Battle Beast Finland</span>
                <span class="event__detail event__detail--medium">Finland Tour, Winter 2024</span>
                <hr>
              </li>
              <li class="event">
                <span class="event__detail event-name event-name--large">Kaunis Kuolematon Finland</span>
                <span class="event__detail event__detail--medium">Finland Tour, Winter 2024</span>
                <hr>
              </li>
              <li class="event">
                <span class="event__detail event-name event-name--large">Mors Subita Finland</span>
                <span class="event__detail event__detail--medium">Finland Tour, Winter 2024</span>
                <hr>
              </li>
            </ul>
            <p><a href="/events/" class="button">All upcoming events</a></p>
          </div>
          <div class="column subsection">
            <h3>Follow us on Facebook for our latest news, photos and happenings!</h3>
            <div class="fb-page" data-href="https://www.facebook.com/enslainmerch/" data-tabs="timeline" data-width="" data-height="" data-small-header="false" data-adapt-container-width="true" data-hide-cover="false" data-show-facepile="true">
              <blockquote cite="https://www.facebook.com/enslainmerch/" class="fb-xfbml-parse-ignore"><a href="https://www.facebook.com/enslainmerch/">Enslain Metal Merch</a></blockquote>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</main>
<!-- @include "partials/_footer.kit" -->
