<!-- $title = Enslain Metal Merch | Concert & Festival Merch Sales Finland-->
<!-- $metaDescription = Merchandise sales, staffing, and management for bands, concerts, festivals, and tours across Finland and internationally. Over 20 years of experience. -->
<!-- $og-img = /assets/img/theme/og/index.jpg -->
<!-- $homeAriaCurrent = aria-current="page" -->
<!-- @include "partials/_header.kit" -->
<main class="main">
  <div class="clip-path-layer">
    <section class="section topflow home-hero">
      <div class="wrapper">
        <h1 class="home-hero__title">Enslain Metal Merch</h1>
        <div class="text-container home-hero__copy">
          <p class="home-hero__lead">If you go to metal gigs in Finland, you've almost certainly bought a T-shirt from us. Unless you don't like wearing clothes.</p>
          <p>Merchandise sales, staffing, management, production, and webshop sales for bands, concerts, and festivals. Over 20 years, hundreds of events, and still loving it.</p>
        </div>
        <div class="home-hero__actions" aria-label="Explore Enslain">
          <a class="button" href="/services/">Work with us</a>
          <a class="button" href="/events/">See our gigs</a>
        </div>
      </div>
    </section>
  </div>
  <div class="clip-path-layer">
    <section class="section">
      <div class="wrapper">
        <h2>Let’s sell some merch!</h2>
        <p>Interested in hiring us, or working with us?</p>
        <ul class="card-group grid--flexible">
          <li class="card card--service">
            <div class="card__img-container">
              <img src="assets/img/content/event-imgs/kalmah-lutakko-table.jpg"  loading="lazy" alt="Kalmah's, Mors Subita's, and Suotana's t-shirts, hats, patches, CDs and vinyls neatly displayed on a table.">
            </div>
            <div class="card__text-container">
              <h3>For bands</h3>
              <p>Looking for local sellers for your gigs, or someone to join your crew on tour? That’s what we do!</p>
              <p><a class="button" href="/services/index.html#services-for-bands">Read more</a></p>
            </div>
          </li>
          <li class="card card--service">
            <div class="card__img-container">
              <img src="assets/img/content/event-imgs/metal-capital-card.jpg"  loading="lazy" alt="Chrissy, Miikka, Amy and Janetta enthusiastically flashing the horns in a large merchandise tent at The Metal Capital festival.">
            </div>
            <div class="card__text-container">
              <h3>For promoters</h3>
              <p>Need an experienced and affordable crew to manage your event’s merchandise sales? We love festivals!</p>
              <p><a class="button" href="/services/index.html#services-for-promoters">Read more</a></p>
            </div>
          </li>
          <li class="card card--service">
            <div class="card__img-container">
              <img src="assets/img/content/event-imgs/steelfest-2023-card.jpg"  loading="lazy" alt="Chrissy, Nadya, Katri, Milla, Serena, Janetta and Aaro are huddled together and smiling, standing in front of and top of the merchandise table at Steelfest 2023.">
            </div>
            <div class="card__text-container">
              <h3>For volunteers</h3>
              <p>Have you always wanted to be part of a crew dedicated to music, or do you love the idea of working at events?</p>
              <p><a class="button" href="/volunteers/index.html">Join us!</a></p>
            </div>
          </li>
        </ul>
        <p class="home-services-note">Metal is our natural habitat, but we also venture into other genres whenever our merch expertise is summoned.</p>
      </div>
    </section>
  </div>
  <div class="clip-path-layer">
    <section class="section home-updates">
      <div class="wrapper">
        <div class="home-updates__grid">
          <div class="home-updates__events">
            <h2>What we’re up to right now</h2>
            <ul class="event-list--featured">
              <!-- @include "partials/events/_featured.kit" -->
            </ul>
            <p><a href="/events/" class="button">All upcoming events</a></p>
          </div>
          <div class="home-instagram" aria-labelledby="home-instagram-title">
            <h2 id="home-instagram-title" class="home-instagram__heading">Life behind the merch table</h2>
            <p class="home-instagram__description">Latest from <a href="https://www.instagram.com/enslainmetalmerch/" target="_blank" rel="noopener noreferrer">@enslainmetalmerch</a>.</p>
            <div class="home-instagram__widget">
              <!-- LightWidget: user-owned upgraded Instagram widget -->
              <script src="https://cdn.lightwidget.com/widgets/lightwidget.js"></script>
              <iframe src="https://cdn.lightwidget.com/widgets/03a2493587035d29b7b8527ccdabdd67.html" scrolling="no" allowtransparency="true" class="lightwidget-widget" title="Latest Instagram posts from Enslain Metal Merch" style="width:100%;border:0;overflow:hidden;"></iframe>
            </div>
            <div class="home-instagram__links">
              <a class="button" href="https://www.instagram.com/enslainmetalmerch/" target="_blank" rel="noopener noreferrer">Follow @enslainmetalmerch</a>
              <span>We're <a href="https://www.facebook.com/enslainmerch/" target="_blank" rel="noopener noreferrer">on Facebook</a> too.</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</main>
<!-- @include "partials/_footer.kit" -->
