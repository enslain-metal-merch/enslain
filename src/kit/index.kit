<!-- $title = Enslain Metal Merch-->
<!-- $homeAriaCurrent = aria-current="page" -->
<!-- @include "partials/_header.kit" -->
<main class="main">
  <div class="clip-path-layer">
    <section class="section">
      <div class="wrapper">
        <div class="grid--two-col">
          <div class="text-container">
            <h1>Enslain Metal Merch</h1>
            <p>Enslain Metal Merch is an independent, music-centric Finnish company with over twenty years of experience selling
            merchandise at events. Our crew consists of friendly and ambitious merch sellers located in numerous major cities
            throughout Finland, and we also do tours internationally.</p>
          </div>
          <div class="img-container"><img src="assets/img/content/enslain-index--resized.jpg" alt=""></div>  
        </div>
      </div>
    </section>
  </div>
  <div class="clip-path-layer">
    <section class="section">
      <div class="wrapper">
        <div class="text-container">
          <h2>Let’s Sell Some Merch!</h2>
          <p>Interested in hiring us, or working with us?</p>
        </div>
        <ul class="grid--flexible">
          <li class="card card--service">
            <div class="card__img-container">
              <img src="assets/img/content/kalmah-lutakko-table--resized.jpg"  loading="lazy" alt="">
            </div>
            <div class="card__text-container">
              <h3>For Bands</h3>
              <p>Looking for local sellers for your gigs, or someone to join your crew on tour? That’s what we do!</p>
              <a class="button" href="/services/index.html#services-for-bands">Read more</a>
            </div>
          </li>
          <li class="card card--service">
            <div class="card__img-container">
              <img src="assets/img/content/metal-capital--resized.jpg"  loading="lazy" alt="">
            </div>
            <div class="card__text-container">
              <h3>For Promoters</h3>
              <p>Need an experienced and affordable crew to manage your festival’s merchandise sales? We love festivals!</p>
              <a class="button" href="/services/index.html#services-for-promotors">Read more</a>
            </div>
          </li>
          <li class="card card--service">
            <div class="card__img-container">
              <img src="assets/img/content/steelfest-2023--resized-2.jpg"  loading="lazy" alt="">
            </div>
            <div class="card__text-container">
              <h3>For Volunteers</h3>
              <p>Have you always wanted to be part of a crew dedicated to music, or do you love the idea of working at events? We’re
              always hiring!</p>
              <a class="button" href="/volunteers/index.html">Join us!</a>
            </div>
          </li>
        </ul>
      </div>
    </section>
  </div>
  <div class="clip-path-layer">
    <section class="section">
      <div class="wrapper">
        <h2>Current Enslain Metal Merch Goings-on</h2>
        <div class="grid--two-col">
          <div class="column subsection">
            <h3>Here's our upcoming events</h3>
            <ul class="event-list">
            <li class="event">
              <span class="event__detail event__detail--large"><a href="">Battle Beast</a></span>
              <span class="event__detail event__detail--medium">Featuring Agalloch, Mare Cognitum, Finnr's Cane</span>
              <span class="event__detail event__detail--small">December 15, 2023 - Ikaalinen spa, Ikaalinen</span>
              <hr>
            </li>
            <li class="event">
              <span class="event__detail event__detail--large"><a href="">Battle Beast</a></span>
              <span class="event__detail event__detail--small">December 16, 2023 - Aulanko, Hämeenlinna</span>
              <hr>
            </li>
              <li class="event">
                <span class="event__detail event__detail--large">Suffocation, Be'lakor, Torture Killer</span>
                <span class="event__detail event__detail--small">October 10th - Lutakko, Jyväskylä</span>
                <hr>
              </li>
              <li class="event">
                <span class="event__detail event__detail--large">Suffocation, Be'lakor, Torture Killer</span>
                <span class="event__detail event__detail--small">October 10th - Lutakko, Jyväskylä</span>
                <hr>
              </li>
              <li class="event">
                <span class="event__detail event__detail--large">Suffocation, Be'lakor, Torture Killer</span>
                <span class="event__detail event__detail--small">October 10th - Lutakko, Jyväskylä</span>
                <hr>
              </li>
            </ul>
          </div>
          <div class="column subsection">
            <h3>Check out our latest news, photos and happenings from our Facebook feed.</h3>
            <div class="fb-page" data-href="https://www.facebook.com/enslainmerch/" data-tabs="timeline" data-width=""
              data-height="" data-small-header="false" data-adapt-container-width="true" data-hide-cover="false"
              data-show-facepile="true">
              <blockquote cite="https://www.facebook.com/enslainmerch/" class="fb-xfbml-parse-ignore"><a
                  href="https://www.facebook.com/enslainmerch/">Enslain Metal Merch</a></blockquote>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</main>
<!-- @include "partials/_footer.kit" -->
