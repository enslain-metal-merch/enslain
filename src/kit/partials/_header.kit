<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><!-- $title --></title>
  <link rel="stylesheet" href="/assets/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Finlandica:wght@400;500;600;700&family=Voltaire&display=swap" rel="stylesheet">
  <script src="https://kit.fontawesome.com/7b408c2776.js" crossorigin="anonymous"></script>
</head>
<body id="site-top">
<div id="fb-root"></div>
<script async defer crossorigin="anonymous" src="https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v18.0"
  nonce="ORr6o31p"></script>
<header class="header">
  <div class="wrapper">
    <div class="header__content">
      <nav class="header__primary-nav js-toggle-primary-nav">
        <ul class="header__primary-menu">
          <li class="header__primary-menu-item"><a href="/">Home</a></li>
          <li class="header__primary-menu-item"><a href="/events/">Events</a></li>
          <li class="header__primary-menu-item"><a href="/services/">Services</a></li>
          <li class="header__primary-menu-item"><a href="/about/">About</a></li>
          <li class="header__primary-menu-item"><a href="/volunteers/">Volunteers</a></li>
          <li class="header__primary-menu-item"><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
      <a class="header__logo" href="/" aria-label="Link to home page">
        <img class="header__logo-img" src="" alt="">
      </a>
      <button class="header__nav-toggle js-nav-toggle-button" aria-label="Open site navigation">
        <span class="header__nav-toggle-bar header__nav-toggle-bar--top"></span>
        <span class="header__nav-toggle-bar header__nav-toggle-bar--center"></span>
        <span class="header__nav-toggle-bar header__nav-toggle-bar--bottom"></span>
      </button>
    </div>
  </div>
</header>
