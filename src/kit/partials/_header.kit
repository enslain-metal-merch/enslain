<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><!-- $title --></title>
  <link rel="stylesheet" href="/assets/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Finlandica:wght@400;500;600;700&family=Voltaire&display=swap" rel="stylesheet">
</head>
<body>
<header class="header">
  <div class="wrapper">
    <div class="header__content">
      <div class="header__logo">
        <p>Enslain</p>
      </div>
      <button class="header__nav-toggle">
        Toggle Nav
      </button>
      <nav class="header__secondary-nav">
        <ul class="header__secondary-menu">
          <li class="header__secondary-menu-item"><button class="header__theme-button header__theme-button--light">Light theme</button></li>
          <li class="header__secondary-menu-item"><button class="header__theme-button header__theme-button--dark">Dark theme</button></li>
          <!-- <li class="header__secondary-menu-item"><button class="header__theme-button header__theme-button--dark">Chrissy mode</button></li> -->
        </ul>
      </nav>
      <nav class="header__primary-nav">
        <ul class="header__primary-menu">
          <li class="header__primary-menu-item"><a href="/">Home</a></li>
          <li class="header__primary-menu-item"><a href="/events/">Events</a></li>
          <li class="header__primary-menu-item"><a href="/services/">Services</a></li>
          <li class="header__primary-menu-item"><a href="/about/">About</a></li>
          <li class="header__primary-menu-item"><a href="/volunteers/">Volunteers</a></li>
          <li class="header__primary-menu-item"><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
    </div>
  </div>
</header>
