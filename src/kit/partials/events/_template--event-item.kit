<!-- No link -->
<li class="event">
  <span class="event__detail event__detail--large">Event Name</span>
  <span class="event__detail event__detail--small">Month Day - Venue, City</span>
</li>

<!-- No link + additional info -->
<li class="event">
  <span class="event__detail event__detail--large">Event Name</span>
  <span class="event__detail event__detail--medium">Featured bands and special info goes here</span>
  <span class="event__detail event__detail--small">Month Day - Venue, City</span>
</li>

<!-- Event with a link -->
<li class="event">
  <span class="event__detail event__detail--large"><a href="">Event Name</a></span>
  <span class="event__detail event__detail--small">Month Day - Venue, City</span>
</li>

<!-- Event with a link + additional info-->
<li class="event">
  <span class="event__detail event__detail--large"><a href="">Event Name</a></span>
  <span class="event__detail event__detail--medium">Featured bands and special info goes here</span>
  <span class="event__detail event__detail--small">Month Day - Venue, City</span>
</li>
