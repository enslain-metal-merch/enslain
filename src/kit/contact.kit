<!-- $title = Contact - Enslain Metal Merch-->
<!-- $contactAriaCurrent = aria-current="page"-->
<!-- @include "partials/_header.kit" -->
<main class="main">
  <div class="clip-path-layer">
    <section class="section topflow">
      <div class="wrapper">
        <div class="grid">
          <div class="text-container">
            <h1>Get in touch!</h1>
            <ul class="contact-methods">
              <li><i class="fa-solid fa-envelope" aria-hidden="true"></i><a href="mailto:contact@enslain.net">contact@enslain.net</a></li>
              <li><i class="fa-brands fa-facebook-messenger" aria-hidden="true"></i></i><a href="https://www.facebook.com/enslainmerch/">Facebook</a></li>
              <li><i class="fa-solid fa-phone" aria-hidden="true"></i>+358 (0)50 324 2552 (Phone/WhatsApp)</li>
              <li aria-hidden="true"><i class="fa-solid fa-shield-cat"></i><a href="https://images.unsplash.com/photo-1486530555807-11f29d0dff36?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2940&q=80">Via Messenger Cat</a></li>
            </ul>
          </div>
          <div class="img-container img-container--framed img-msg-to-chrissy">
            <img src="/assets/img/content/contact-placeholder.jpg" alt="">
            <div class="overlay">
              <p>Brilliant idea: Ask Miikka to get a landscape picture of you working on your laptop and either Pepper or Snickers (or both) at your side!</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</main>
