<!-- default event -->
<li>Month Date, Year - <span class="event-name"></span> - Venue, City<hr></li>

<!-- featured event -->
<li class="event">
  <span class="event__detail event-name event-name--large"></span>
  <span class="event__detail event__detail--medium"></span>
  <span class="event__detail event-secondary-info"></span>
</li>

<!-- 
  Emmet formulas for max efficiency:
    Single event:
      li.event*#>{Month Date, Year - }+span.event-name+{ - Venue, City}+hr
  
  With secondary info:
    li.event*#>{Month Start date - end date, Year - }+span.event-name+{ - Venue, City}+br+span.event-secondary-info{Secondary event info}+hr

  Featured event:
    li.event>span.event__detail.event-name.event-name--large+span.event__detail.event__detail--medium+span.event__detail.event-secondary-info+hr
 -->
