<div class="subsection">
  <h3>Year</h3>
  <ul class="event-list">
    <li class="event grid--event">
      <div class="column">
        <p class="event__date">Event date(s)</p>
      </div>
      <div class="column">
        <p class="event__name">Event Name</p>
        <div class="event__location">
          <p class="event__venue">Event Venue</p>
          <p class="event__city">Event City</p>
        </div>
      </div>
    </li>
    <li class="event grid--event">
      <div class="column">
        <p class="event__date">pe 22.9 - la 23.9</p>
      </div>
      <div class="column">
        <p class="event__name">Helsinki Tech Fest</p>
        <div class="event__location">
          <p class="event__venue">On the Rocks</p>
          <p class="event__city">Helsinki</p>
        </div>
      </div>
    </li>
  </ul>
</div>
